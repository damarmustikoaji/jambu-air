# ============================
# Search Configuration
# ============================
SEARCH_QUERY=automation
TIKTOK_ENABLED=true
THREADS_ENABLED=true

# ============================
# Scraping Limits
# ============================
TIKTOK_MAX_RESULTS=20
THREADS_MAX_RESULTS=20

# ============================
# Browser Settings
# ============================
HEADLESS=true
SLOW_MO=500

# ============================
# Cookies / Session (opsional)
# Jika platform butuh login, export cookies browser ke JSON
# dan set path file-nya di sini
# ============================
TIKTOK_COOKIES_FILE=
THREADS_COOKIES_FILE=

# ============================
# API Destination
# ============================
API_URL=https://fakerestapi.azurewebsites.net/api/v1/Activities
API_KEY=your-api-key-here
API_TIMEOUT=30
